231             W('HEXADECIMAL RADIX, CHARACTERS ARE GIVEN');   505  11    8:1   275             W('AS THEIR ASCII VALUE AS NUMBERS AND AS');   506  11    8:1   318             W('THEIR ASCII MNEMONIC.  BOOLEANS ARE');   507  11    8:1   358             W('EITHER TRUE OR FALSE.  ENTER NUMBERS, OR');   508  11    8:1   403             W('CHARACTERS AS THEIR ASCII NUMERIC VALUE,');   509  11    8:1   448             W('ACCORDING TO THE FORMAT:');   510  11    8:1   477             PAGE;   511  11    8:1   479             W('!->O-{OCTAL}-!');   512  11    8:1   498             W('!            !');   513  11    8:1   517             W('--DEFAULT----!----------->DIGIT--->(CR)');   514  11    8:1   561             W('!            ! !      ! !        !');   515  11    8:1   600             W('!->H-{HEX}---! !->(-)-! !-DIGIT<-!');   516  11    8:1   639             W('!            !');   517  11    8:1   658             W('!->D{DECIMAL}!');   518  11    8:1   677             PAGE;   519  11    8:0   679           END;   520  11    8:0   692              521  11    9:D     1           PROCEDURE PART5;   522  11    9:0     0           BEGIN   523  11    9:0     0             {  0        1         2         3         4  }   524  11    9:0     0             {  1234567890123456789012345678901234567890  }   525  11    9:1     0             W('THE DEFAULT RADIX STARTS AS DECIMAL.');   526  11    9:1    41             W('NON-PRINTING CHARACTERS MAY BE INPUT');   527  11    9:1    82             W('BY TYPING THE KEY WHICH GENERATES THEIR');   528  11    9:1   126             W('VALUE (FOLLOWED BY CR) OR, IF THERE IS');   529  11    9:1   169             W('AN ASCII MNEMONIC FOR THAT CHARACTER,');   530  11    9:1   211             W('JUST TYPE IT IN (AND CR). BOOLEANS ARE');   531  11    9:1   254             W('INPUT BY TYPING "TRUE" OR "FALSE"');   532  11    9:1   292             W('(AND CR).  FOR MORE INFORMATION,');   533  11    9:1   329           