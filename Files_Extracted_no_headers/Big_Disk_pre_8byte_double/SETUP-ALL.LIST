     1   1    1:D     1 {$L SETUP-ALL.LIST}     2   1    1:D     1 {$C II0D1 Copyright(c)1979 Regents of the University of California, San Diego}     3   1    1:D     1      4   1    1:D     1     (******************************************************************)     5   1    1:D     1     (*                                                                *)     6   1    1:D     1     (*        SETUP    System reconfiguration utility                 *)     7   1    1:D     1     (*        Author:  J. Greg Davidson                               *)     8   1    1:D     1     (*        Date:    11 April, 1979                                 *)     9   1    1:D     1     (*        Time:    9:13 P.M.                                      *)    10   1    1:D     1     (*        Version: D1      (for UCSD Pascal system version II.0)  *)    11   1    1:D     1     (*        Institute for Information Systems                       *)    12   1    1:D     1     (*        University of California, San Diego                     *)    13   1    1:D     1     (*        La Jolla, California                                    *)    14   1    1:D     1     (*        Director: Kenneth L. Bowles                             *)    15   1    1:D     1     (*                                                                *)    16   1    1:D     1     (*  Copyright (c) l979 Regents of the University of California.   *)    17   1    1:D     1     (*  Permission to copy or distribute this software or documen-    *)    18   1    1:D     1     (*  tation in hard or soft copy granted only by written license   *)     19   1    1:D     1     (*  obtained from the Institute for Information Systems.          *)    20   1    1:D     1     (*                                                                *)    21   1    1:D     1     (******************************************************************)    22   1    1:D     1         23   1    1:D     1         24   1    1:D     1 {$S+}    25   1    1:D     1 {$U-}    26   0    1:D     1 PROGRAM PASCALSYSTEM;    27   0    1:D     1 CONST    28   0    1:D     1   VERSION    = '[D1]'; {Must be changed everytime new version released}    29   0    1:D     1   STARTINDEX = 29; {The first word index in miscinforec setup cares about}    30   0    1:D     1   ENDINDEX   = 47; {The last word index in miscinforec setup cares about}    31   0    1:D     1   BITINDMAX  = 15; {Bits in words are indexed 0..15}    32   0    1:D     1   WIDTHMAX   = 16; {BITINDMAX + 1}    33   0    1:D     1   WRDINDMAX  = 95; {Miscinforec is 0..95 = 96 words long}    34   0    1:D     1 TYPE    35   0    1:D     1   WORD       = PACKED ARRAY[0..15] OF 0..1;    36   0    1:D     1   {As far as this program is concerned, syscom is the following unstructured    37   0    1:D     1   array of words, each of which is just a bunch of bits.  Setup merely knows,    38   0    1:D     1   for each field in syscom, what the word index is, what the bit index is    39   0    1:D     1   within the word, and how many bits wide the field is.  Fields may not overlap    40   0    1:D     1   word boundaries.  Setup may treat any such identifier as a scalar list of    41   0    1:D     1   mnemonic values (with synonyms allowed, e.g. True = T, F = False, etc.),    42   0    1:D     1   or as a packed non-negative integer, or as a character.}    43   0    1:D     1   MISCINFOREC   = ARRAY[0..WRDINDMAX] OF WORD;    44   0    1:D     1 VAR    45   0    1:D     1   PSYSCOM: ^MISCINFOREC;    46   0    1:D     2       47   1    1:D     1 SEGMENT PROCEDURE SETUP(III,JJJ:INTEGER{NOT USED});    48   1    1:D     3 CONST    49   1    1:D     3   NEWINFO  = '*NEW.MISCINFO';    50   1    1:D     3   BS        = '/';    51   1    1:D     3   DEL       = '<';    52   1    1:D     3   ESC       = '!';    53   1    1:D     3 TYPE    54   1    1:D     3   TRIGRAPH = STRING[3]; {For storing the mnemonics of ASCII non-printables}    55   1    1:D     3       56   1    1:D     3   SCALVAL  = 0..MAXINT; {Scalars must have non-negative ords}    57   1    1:D     3   {Scalar mnemonics are a linked list of mnemonic identifiers, each of    58   1    1:D     3   which has a value.  More than one identifier can have the same value,    59   1    1:D     3   allowing for synonyms.}    60   1    1:D     3   SCALARS  = ^SCALREC; SCALREC = RECORD    61   1    1:D     3                LINK: SCALARS;    62   1    1:D     3                VAL:  SCALVAL;    63   1    1:D     3                NAME: STRING {Without fail must be last field in record!}    64   1    1:D     3              END;    65   1    1:D     3       66   1    1:D     3   INDEXRANGE = 0..WRDINDMAX; {Word index range}    67   1    1:D     3   BITRANGE   = 0..BITINDMAX;    68   1    1:D     3   WIDTHRANGE = 0..WIDTHMAX;  {Range of field widths in bits}    69   1    1:D     3   {The identifiers are all entered in a tree.  Like any good tree each node    70   1    1:D     3   has left and right subtree pointers, and a name field.  As related above,    71   1    1:D     3   fields are simply a bunch of contiguous bits in a word in miscinforec, so    72   1    1:D     3   each has a wordindex, bitindex and bitwidth.  If it is to be interpreted    73   1    1:D     3   as a (non-negative) integer, VALNAMES points to the record NUMBER, if it    74   1    1:D     3   is to be interpreted as a character, VALNAMES points to the record    75   1    1:D     3   CHARACTER, otherwise, valnames points to the list of scalar mnemonic    76   1    1:D     3   identifier strings.}    77   1    1:D     3   TREE     = ^TREEREC; TREEREC = RECORD    78   1    1:D     3                WORDINDEX:  INDEXRANGE;    79   1    1:D     3                BITINDEX:   BITRANGE;    80   1    1:D     3                WIDTH:      WIDTHRANGE;    81   1    1:D     3                VALNAMES:   SCALARS;    82   1    1:D     3                LEFT,RIGHT: TREE;    83   1    1:D     3                NAME:       STRING {Without fail must be last field in record!}    84   1    1:D     3              END;    85   1    1:D     3     86   1    1:D     3 VAR    87   1    1:D     3   c:          CHAR;  {All single character input is done through c}    88   1    1:D     4   DEFRADIX:    8..16;    89   1    1:D     5   ABORT:   BOOLEAN;  {True if the user typed the abort character 'ESC'}    90   1    1:D     6   {The tree of field identifiers dangles from ROOT.  All left and right    91   1    1:D     6   pointers point to the node GROUND.  Note that if name field of GROUND    92   1    1:D     6   is set to the thing one is looking for, one will always find it without    93   1    1:D     6   having to check for running off the tree within the loop.  TREEPTR is    94   1    1:D     6   used to traverse the tree, TRAIL is always pointing to the parent of    95   1    1:D     6   TREEPTR, i.e., it trails one behind.}    96   1    1:D     6   ROOT,GROUND,TREEPTR,TRAIL: TREE;    97   1    1:D    10   SCALGROUND, {The end of each list of scalar mnemonic values points to this}    98   1    1:D    10     NUMBER, {The scalar values field of all numbers points to this}    99   1    1:D    10     CHARACTER {The scalar values field of all characters points to this}   100   1    1:D    10     :  SCALARS;   101   1    1:D    13   DELTAWORD,DOTCOUNT:INTEGER;   102   1    1:D    15   {At the start of the program, syscom is copied into BUFFER.  All changes   103   1    1:D    15   specified by the user are actually only made in BUFFER.  Only if the user   104   1    1:D    15   asks for a memory update is BUFFER copied back into syscom.  If the user   105   1    1:D    15   askes for a disk update, BUFFER is written to disk under the name   106   1    1:D    15   NEW.MISCINFO.}   107   1    1:D    15   BUFFER       :MISCINFOREC;   108   1    1:D   111   {The Mnemonics of the first 34 ASCII characters are stored in LOWASCIIS}   109   1    1:D   111   LOWASCIIS:   ARRAY [0..33] OF TRIGRAPH;   110   1    1:D   179    111   1    2:D     1      PROCEDURE ASSERT(B:BOOLEAN;LOC:STRING);   112   1    2:D    44      {Assert is called when a condition B simply must be true or a bug   113   1    2:D    44      exists in setup.  It reports on where the error occured (LOC)}   114   1    2:D    44        FORWARD;   115   1    2:D    44         116   1    3:D     3      FUNCTION TREESEARCH(KEY:STRING):BOOLEAN;   117   1    3:D    45      {Looks up KEY in the tree.  TREEPTR is left pointing to the node   118   1    3:D    45      if it exists.  Otherwise, TREESEARCH returns False}   119   1    3:D    45        FORWARD;   120   1    3:D    45         121   1    4:D     1      PROCEDURE DESPACE(VAR TEMP:STRING;VAR STR:STRING);   122   1    4:D     3      {It is desirable that spaces not be significant; however, for clarity,   123   1    4:D     3      one wants to be able to use spaces in long identifiers and allow the   124   1    4:D     3      user to type them in.  Thus, when looking up identifiers in the table,   125   1    4:D     3      one first despaces them, and also despaces the keys in the tree with   126   1    4:D     3      which one compares them during the search.}   127   1    4:D     3        FORWARD;   128   1    4:D     3           129   1    4:D     3      {Adjust segment numbers so INITS will be number 10}   130   2    1:D     1         SEGMENT PROCEDURE NUMBER2;  FORWARD;   131   3    1:D     1         SEGMENT PROCEDURE NUMBER3;  FORWARD;   132   4    1:D     1         SEGMENT PROCEDURE NUMBER4;  FORWARD;   133   5    1:D     1         SEGMENT PROCEDURE NUMBER5;  FORWARD;   134   6    1:D     1         SEGMENT PROCEDURE NUMBER6;  FORWARD;   135   7    1:D     1         SEGMENT PROCEDURE NUMBER7;  FORWARD;   136   8    1:D     1         SEGMENT PROCEDURE NUMBER8;  FORWARD;   137   9    1:D     1         SEGMENT PROCEDURE NUMBER9;  FORWARD;   138   9    1:D     1           139  10    1:D     1      SEGMENT PROCEDURE INITS;   140  10    1:D     1      TYPE   141  10    1:D     1        HEAPMAGIC = RECORD   142  10    1:D     1                      CASE INTEGER OF   143  10    1:D     1                        0:(INT:INTEGER);   144  10    1:D     1                        1:(PTR:^INTEGER)   145  10    1:D     1                    END;{CASERECORD}   146  10    1:D     1      VAR   147  10    1:D     1        HEAP:HEAPMAGIC;   148  10    1:D     2        INDEX: INDEXRANGE;   149  10    1:D     3              150  10    2:D     1           PROCEDURE INITASCII;   151  10    2:D     1           VAR   152  10    2:D     1             ORDCHR:-1..32;   153  10    2:D     2              154  10    3:D     1                PROCEDURE A(MNEMONIC:TRIGRAPH);   155  10    3:0     0                BEGIN   156  10    3:1     0                  ORDCHR := ORDCHR + 1;   157  10    3:1    13                  LOWASCIIS[ORDCHR] := MNEMONIC;   158  10    3:0    24                END;   159  10    3:0    36              160  10    2:0     0           BEGIN {INITASCII}   161  10    2:1     0             ORDCHR := -1;   162  10    2:1     4             A('NUL');  A('SOH');  A('STX');  A('ETX');  A('EOT');   163  10    2:1    44             A('ENQ');  A('ACK');  A('BEL');  A('BS' );  A('HT' );   164  10    2:1    82             A('LF' );  A('VT' );  A('FF' );  A('CR' );  A('SO' );   165  10    2:1   117             A('SI' );  A('DLE');  A('DC1');  A('DC2');  A('DC3');   166  10    2:1   156             A('DC4');  A('NAK');  A('SYN');  A('ETB');  A('CAN');   167  10    2:1   196             A('EM' );  A('SUB');  A('ESC');  A('FS' );  A('GS' );   168  10    2:1   233             A('RS' );  A('US' );  A('SP' );   169  10    2:0   254           END; {INITASCII}   170  10    2:0   266              171  10    4:D     1           PROCEDURE INITTREE;   172  10    4:D     1           VAR   173  10    4:D     1             SCAL:SCALARS;   174  10    4:D     2             PWIDTH:WIDTHRANGE;   175  10    4:D     3              176  10    5:D     1           PROCEDURE CUTHEAP(STR:STRING);   177  10    5:D    43           {   178  10    5:D    43           * This procedure assumes:   179  10    5:D    43           * 1)  The last NEW statement allocated a record on the stack.   180  10    5:D    43           * 2)  The record is not a CASE record.   181  10    5:D    43           * 3)  The last field of the record is of type STRING (STRING[80]).   182  10    5:D    43           * 4)  That last field has been initialized with the string STR.   183  10    5:D    43           * 5)  That last field will never again be changed.   184  10    5:D    43           * 6)  This is the only heap diddling code in the program.   185  10    5:D    43           * The purpose of this procedure is to deallocate the unused part of   186  10    5:D    43           * the string forming the last part of that record.   187  10    5:D    43           }   188  10    5:D    43           VAR   189  10    5:D    43             HEAPTRIX: HEAPMAGIC;   190  10    5:0     0           BEGIN   191  10    5:1     0             MARK(HEAPTRIX.PTR);   192  10    5:1     9             HEAPTRIX.INT := HEAPTRIX.INT   193  10    5:1     9                                    + ((LENGTH(STR) + 1) DIV 2 - 40) * DELTAWORD;   194  10    5:1    26             RELEASE(HEAPTRIX.PTR);   195  10    5:0    30           END;   196  10    5:0    42              197  10    6:D     1           PROCEDURE ENTER(PNAME:STRING;PWRD:INDEXRANGE;PBIT:BITRANGE);   198  10    6:D    45           {Enters the indentifier whose name is PNAME into the tree, and   199  10    6:D    45           sets all of the fields of its node, some of which are passed to   200  10    6:D    45           ENTER, the rest are passed in variables global to ENTER}   201  10    6:D    45           VAR   202  10    6:D    45             B:BOOLEAN;   203  10    6:D    46             TEMP1,TEMP2:STRING;   204  10    6:0     0           BEGIN   205  10    6:1     0             WRITE('.');   206  10    6:1    13             DOTCOUNT := DOTCOUNT + 1;   207  10    6:1    18             IF DOTCOUNT = 40 THEN   208  10    6:2    23               BEGIN   209  10    6:3    23                 WRITELN;   210  10    6:3    29                 DOTCOUNT := 0;   211  10    6:2    32               END;   212  10    6:1    32             DESPACE(TEMP1,PNAME);   213  10    6:1    39             B := TREESEARCH(TEMP1); {Check for a duplicate entry...}   214  10    6:1    48             ASSERT(NOT B,CONCAT('ENTER ',PNAME)); {which would be an error}   215  10    6:1    86             NEW(TREEPTR);   216  10    6:1    91             WITH TREEPTR^ DO   217  10    6:2    95               BEGIN   218  10    6:3    95                 NAME := PNAME;   219  10    6:3   104                 CUTHEAP(NAME);   220  10    6:3   111                 WORDINDEX := PWRD;   221  10    6:3   116                 BITINDEX := PBIT;   222  10    6:3   123                 WIDTH := PWIDTH;   223  10    6:3   132                 VALNAMES := SCAL;   224  10    6:3   141                 LEFT := GROUND;   225  10    6:3   148                 RIGHT := GROUND;   226  10    6:2   155               END;   227  10    6:1   155             DESPACE(TEMP1,TRAIL^.NAME);   228  10    6:1   163             DESPACE(TEMP2,PNAME);   229  10    6:1   170             IF TEMP1 > TEMP2 THEN   230  10    6:2   178               TRAIL^.LEFT := TREEPTR   231  10    6:1   181             ELSE   232  10    6:2   185               TRAIL^.RIGHT := TREEPTR;   233  10    6:0   190           END;   234  10    6:0   202              235  10    7:D     1           PROCEDURE NEXT(ORDVAL:SCALVAL;STR:STRING);   236  10    7:D    44           {Assumes that SCAL points to a partially constructed list of   237  10    7:D    44           scalar mnemonics.  Adds the mnemonic STR to that list and leaves   238  10    7:D    44           SCAL pointing to the new list.  Note that the identifiers appear   239  10    7:D    44           in the list in the reverse order that they are added by NEXT.  Also   240  10    7:D    44           note that in displaying the value of a field which may have synonyms   241  10    7:D    44           for some values, the first synonym encountered on the list is   242  10    7:D    44           always displayed.  Thus, TRUE should come before T, etc. and    243  10    7:D    44           therefore one should NEXT(...T) before one does NEXT(...TRUE)}   244  10    7:D    44           VAR   245  10    7:D    44             TEMP:SCALARS;   246  10    7:0     0           BEGIN   247  10    7:1     0             NEW(TEMP);   248  10    7:1    10             WITH TEMP^ DO   249  10    7:2    14               BEGIN   250  10    7:3    14                 LINK := SCAL;   251  10    7:3    20                 VAL  := ORDVAL;   252  10    7:3    26                 NAME := STR;   253  10    7:3    34                 CUTHEAP(NAME)   254  10    7:2    38               END;   255  10    7:1    40             SCAL := TEMP;   256  10    7:0    45           END;   257  10    7:0    58              258  10    8:D     1           PROCEDURE SETUP1;   259  10    8:0     0           BEGIN   260  10    8:0     0             {Set up the boolean fields}   261  10    8:0     0               {Construct the list of mnemonics for Boolean values,   262  10    8:0     0               and leave SCAl pointing to that list}   263  10    8:1     0                 SCAL := SCALGROUND;   264  10    8:1     4                 NEXT(1,'T');   265  10    8:1     8                 NEXT(0,'F');   266  10    8:1    12                 NEXT(1,'TRUE');   267  10    8:1    22                 NEXT(0,'FALSE');   268  10    8:1    33               PWIDTH := 1; {Booleans all have a width in bits of 1}   269  10    8:1    37               ENTER('HAS CLOCK',                        29, 0);   270  10    8:1    53               ENTER('HAS 8510A',                        29, 1);   271  10    8:1    69               ENTER('HAS LOWER CASE',                   29, 2);   272  10    8:1    90               ENTER('HAS RANDOM CURSOR ADDRESSING',     29, 3);   273  10    8:1   125               ENTER('HAS SLOW TERMINAL',                29, 4);   274  10    8:1   149               ENTER('STUDENT',                          29, 5);   275  10    8:1   163               ENTER('HAS BYTE FLIPPED MACHINE',         29, 9);   276  10    8:1   194               ENTER('HAS WORD ORIENTED MACHINE',        29,10);   277  10    8:1   226                278  10    8:1   226             {PREFIXED FOR CRTCTRL}   279  10    8:1   226               ENTER('PREFIXED[MOVE CURSOR UP]',                 36, 0);   280  10    8:1   257               ENTER('PREFIXED[MOVE CURSOR RIGHT]',              36, 1);   281  10    8:1   291               ENTER('PREFIXED[ERASE TO END OF LINE]',           36, 2);   282  10    8:1   328               ENTER('PREFIXED[ERASE TO END OF SCREEN]',         36, 3);   283  10    8:1   367               ENTER('PREFIXED[MOVE CURSOR HOME]',               36, 4);   284  10    8:1   400               ENTER('PREFIXED[DELETE CHARACTER]',               36, 5);   285  10    8:1   433               ENTER('PREFIXED[ERASE SCREEN]',                   36, 6);   286  10    8:1   462               ENTER('PREFIXED[ERASE LINE]',                     36, 7);   287  10    8:1   489                  288  10    8:1   489             {PREFIXED FOR CRTINFO}   289  10    8:1   489               ENTER('PREFIXED[KEY TO MOVE CURSOR RIGHT]',       47,  0);   290  10    8:1   530               ENTER('PREFIXED[KEY TO MOVE CURSOR LEFT]',        47,  1);   291  10    8:1   570               { The following two entries were reversed May 14, 1979   292  10    8:1   570                 by Bruce Sherman to solve the bug of them being switched}   293  10    8:1   570               ENTER('PREFIXED[KEY TO MOVE CURSOR UP]',          47,  3);   294  10    8:1   608               ENTER('PREFIXED[KEY TO MOVE CURSOR DOWN]',        47,  2);   295  10    8:1   648               ENTER('PREFIXED[NON PRINTING CHARACTER]',         47,  4);   296  10    8:1   687               ENTER('PREFIXED[KEY FOR STOP]',                   47,  6);   297  10    8:1   716               ENTER('PREFIXED[KEY FOR BREAK]',                  47,  7);   298  10    8:1   746               ENTER('PREFIXED[KEY FOR FLUSH]',                  47,  8);   299  10    8:1   776               ENTER('PREFIXED[KEY TO END FILE]',                47,  9);   300  10    8:1   808               ENTER('PREFIXED[EDITOR ESCAPE KEY]',              47, 10);   301  10    8:1   842               ENTER('PREFIXED[KEY TO DELETE LINE]',             47, 11);   302  10    8:1   877               ENTER('PREFIXED[KEY TO DELETE CHARACTER]',        47, 12);   303  10    8:1   917               ENTER('PREFIXED[EDITOR ACCEPT KEY]',              47, 13);   304  10    8:0   951           END; {SETUP1}   305  10    8:0   964              306  10    9:D     1           PROCEDURE SETUP2;   307  10    9:0     0           BEGIN   308  10    9:0     0             {Set up the integer fields}   309  10    9:1     0               PWIDTH := 16; {Integers all have a width in bits of 16}   310  10    9:1     4               SCAL := NUMBER; {Tells system that the identifier is a number}   311  10    9:1     8               ENTER('SCREEN HEIGHT',    37,0);   312  10    9:1    28               ENTER('SCREEN WIDTH',     38,0);   313  10    9:1    47                314  10    9:1    47             {Set up the character fields}   315  10    9:1    47               PWIDTH := 8; {Characters all have a width in bits of 8}   316  10    9:1    51               SCAL := CHARACTER; {TeIdentifiers are all characters}   317  10    9:1    55               ENTER('LEAD IN TO SCREEN',                31,0);   318  10    9:1    79               ENTER('MOVE CURSOR HOME',                 31,8);   319  10    9:1   102               ENTER('ERASE TO END OF SCREEN',           32,0);   320  10    9:1   131               ENTER('ERASE TO END OF LINE',             32,8);   321  10    9:1   158               ENTER('MOVE CURSOR RIGHT',                33,0);   322  10    9:1   182               ENTER('MOVE CURSOR UP',                   33,8);   323  10    9:1   203               ENTER('BACKSPACE',                        34,0);   324  10    9:1   219               ENTER('ERASE LINE',                       35,0);   325  10    9:1   236               ENTER('ERASE SCREEN',                     35,8);   326  10    9:1   255               ENTER('KEY TO MOVE CURSOR UP',            39,0);   327  10    9:1   283               ENTER('KEY TO MOVE CURSOR DOWN',          39,8);   328  10    9:1   313               ENTER('KEY TO MOVE CURSOR LEFT',          40,0);   329  10    9:1   343               ENTER('KEY TO MOVE CURSOR RIGHT',         40,8);   330  10    9:1   374               ENTER('KEY TO END FILE',                  41,0);   331  10    9:1   396               ENTER('KEY FOR FLUSH',                    41,8);   332  10    9:1   416               ENTER('KEY FOR BREAK',                    42,0);   333  10    9:1   436               ENTER('KEY FOR STOP',                     42,8);   334  10    9:1   455               ENTER('NON PRINTING CHARACTER',           43,8);   335  10    9:1   484               ENTER('KEY TO DELETE LINE',               44,0);   336  10    9:1   509               ENTER('EDITOR ESCAPE KEY',                44,8);   337  10    9:1   533               ENTER('LEAD IN FROM KEYBOARD',            45,0);   338  10    9:1   561               ENTER('EDITOR ACCEPT KEY',                45,8);   339  10    9:1   585               ENTER('KEY TO DELETE CHARACTER',          43,0);   340  10    9:1   615                  341  10    9:1   615             {Set up miscellaneous fields}   342  10    9:1   615               SCAL := NUMBER;   343  10    9:1   619               ENTER('VERTICAL MOVE DELAY',  34,8); {A number 0..255}   344  10    9:0   645           END; {SETUP2}   345  10    9:0   658    346  10    4:0     0           BEGIN {INITTREE}   347  10    4:0     0             {Initialize the initially empty tree.  Note that the empty tree   348  10    4:0     0             has the node ROOT in it and that the in use part of the tree will   349  10    4:0     0             dangle from ROOT's right link.  Thus, even the first entry added   350  10    4:0     0             to the tree will have a parent, ROOT, which is important for a   351  10    4:0     0             clean search algorithm.}   352  10    4:1     0               NEW(ROOT);   353  10    4:1     5               WITH ROOT^ DO   354  10    4:2     8                 BEGIN   355  10    4:3     8                   NAME := '';   356  10    4:3    16                   NEW(RIGHT);   357  10    4:2    22                 END;   358  10    4:1    22               GROUND := ROOT^.RIGHT;   359  10    4:1    26             {Just as the tree has GROUND, each unused link at the end of   360  10    4:1    26             each list of mnemonic scalars points to SCALGROUND, which   361  10    4:1    26             simplifies lookup, since one simply sets the name field of   362  10    4:1    26             SCALGROUND to be the thing one is looking for and then goes   363  10    4:1    26             through the list looking for it without worrying about falling   364  10    4:1    26             off the end of the list if it isn't there}   365  10    4:1    26             NEW(SCALGROUND);   366  10    4:1    31             NEW(NUMBER);   367  10    4:1    36             CUTHEAP('');   368  10    4:1    41             NEW(CHARACTER);   369  10    4:1    46             CUTHEAP('');   370  10    4:1    51             SETUP1;   371  10    4:1    53             SETUP2;   372  10    4:0    55           END; {INITTREE}   373  10    4:0    68              374  10    1:0     0      BEGIN {INITS}   375  10    1:1     0        ASSERT(WIDTHMAX = BITINDMAX + 1,'INITS');   376  10    1:1    16        {Set DELTAWORD to be the difference in the heap pointer for the   377  10    1:1    16        allocation of one word, i.e., 1 on word addressing machines,   378  10    1:1    16        2 on byte addressed machines.}   379  10    1:1    16          MARK(HEAP.PTR);   380  10    1:1    20          DELTAWORD := HEAP.INT;   381  10    1:1    23          NEW(HEAP.PTR);   382  10    1:1    28          MARK(HEAP.PTR);   383  10    1:1    32          DELTAWORD := HEAP.INT-DELTAWORD;   384  10    1:1    37        {Copy that part of syscom in which we are interested over into BUFFER}   385  10    1:1    37          FOR INDEX := STARTINDEX TO ENDINDEX DO   386  10    1:2    48            BUFFER[INDEX] := PSYSCOM^[INDEX];   387  10    1:1    68        ABORT := FALSE;   388  10    1:1    71        INITASCII;   389  10    1:1    73        WRITE('INITIALIZING');   390  10    1:1    95        DOTCOUNT := 12;   391  10    1:1    98        INITTREE;   392  10    1:1   100        WRITELN;   393  10    1:1   106        DEFRADIX := 10; {The initial default radix is base 10}   394  10    1:0   109      END; {INITS}   395  10    1:0   124         396   1    5:D     3      FUNCTION GETCH:CHAR;   397   1    5:D     3      {All single character input is done through GETCH}   398   1    5:D     3        FORWARD;   399   1    5:D     3         400   1    6:D     3      FUNCTION CONTINUE:BOOLEAN;   401   1    6:D     3      {Asks user if he wants to continue}   402   1    6:D     3        FORWARD;   403   1    6:D     3         404  11    1:D     1      SEGMENT PROCEDURE TEACHSETUP;   405  11    1:D     1         406  11    2:D     1           PROCEDURE W(STR:STRING);   407  11    2:0     0           BEGIN   408  11    2:1     0             WRITELN(STR);   409  11    2:0    20           END;   410  11    2:0    32              411  11    3:D     1           PROCEDURE PAGE;   412  11    3:0     0           BEGIN   413  11    3:1     0             IF CONTINUE THEN   414  11    3:2     7               WRITELN   415  11    3:1     7             ELSE   416  11    3:2    15               EXIT(TEACHSETUP);   417  11    3:0    19           END;   418  11    3:0    32         419  11    4:D     1           PROCEDURE HASSLEGOTOXY;   420  11    4:0     0           BEGIN   421  11    4:0     0             {  0        1         2         3         4  }   422  11    4:0     0             {  1234567890123456789012345678901234567890  }   423  11    4:1     0             W('IF YOU HAVE A VIDEO TERMINAL AND EXPECT');   424  11    4:1    44             W('TO USE THE SCREEN ORIENTED EDITOR, THE');   425  11    4:1    87             W('CHANGES SETUP CAN MAKE WILL BE NOT BE');   426  11    4:1   129             W('SUFFICIENT.  YOU WILL ALSO HAVE TO BIND');   427  11    4:1   173             W('IN THE PROCEDURE GOTOXY IN THE OPERATING');   428  11    4:1   218             W('SYSTEM. SEE SECTION 4.7 OF THE DOCUMENT.');   429  11    4:1   263             PAGE;   430  11    4:0   265           END;   431  11    4:0   278         432  11    5:D     1           PROCEDURE PART1;   433  11    5:0     0           BEGIN   434  11    5:0     0             {  0        1         2         3         4  }   435  11    5:0     0             {  1234567890123456789012345678901234567890  }   436  11    5:1     0             W('NOTE: DISK UPDATES CREATE THE FILE:');   437  11    5:1    40             W('         NEW.MISCINFO');   438  11    5:1    66             W('ON YOUR DISK. THE NAME OF THIS FILE MUST');   439  11    5:1   111             W('BE CHANGED USING THE FILER TO: ');   440  11    5:1   147             W('         SYSTEM.MISCIN