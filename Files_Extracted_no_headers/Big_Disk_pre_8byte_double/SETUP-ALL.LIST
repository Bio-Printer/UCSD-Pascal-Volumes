ION AND ANY');   569   1    2:3   102            WRITELN('SUPPORTING DETAILS YOU CAN, AND REPORT');   570   1    2:3   156            WRITELN('IT TO THE UCSD SUPPORT STAFF AT YOUR');   571   1    2:3   208            WRITELN('EARLIEST CONVENIENCE');   572   1    2:3   244         573   1    2:3   244      { ---> } EXIT ( SETUP ) ;   574   1    2:3   248             575   1    2:2   248          END;   576   1    2:0   248      END;   577   1    2:0   262         578   1    5:D     3      FUNCTION GETCH{:CHAR};   579   1    5:0     0      BEGIN   580   1    5:1     0        READ(KEYBOARD,c);   581   1    5:1     8        IF EOLN(KEYBOARD) THEN   582   1    5:2    18          c := CHR(13)   583   1    5:1    19        ELSE IF c IN ['a'..'z'] THEN   584   1    5:3    46          c := CHR( ORD(c) - ORD('a') + ORD('A') );   585   1    5:1    53        IF c = ESC THEN   586   1    5:2    58          ABORT := TRUE;   587   1    5:1    61        GETCH := c;   588   1    5:0    64      END;   589   1    5:0    76         590   1    7:D     3      FUNCTION GETSTR(VAR STR:STRING):BOOLEAN;   591   1    7:D     4      {All non-single-character input is done by GETSTR and is   592   1    7:D     4      terminated by a carriage return or the abort character. Returns False   593   1    7:D     4      if input was terminated by the abort character.}   594   1    7:D     4      VAR   595   1    7:D     4        BACKSPACEING:BOOLEAN;   596   1    7:0     0      BEGIN   597   1    7:1     0        GETSTR := TRUE;   598   1    7:1     3        BACKSPACEING := FALSE;   599   1    7:1     6        STR := '';   600   1    7:1    12        WHILE NOT (GETCH IN [CHR(13),ESC]) DO   601   1    7:2    32          BEGIN   602   1    7:3    32            IF (c <> BS) AND BACKSPACEING THEN   603   1    7:4    39              BEGIN   604   1    7:5    39                BACKSPACEING := FALSE;   605   1    7:5    42                WRITE('>');   606   1    7:4    50              END;   607   1    7:3    50            IF c = DEL THEN   608   1    7:4    55              BEGIN   609   1    7:5    55                STR := '';   610   1    7:5    61                WRITELN('<<ZAP>>');   611   1    7:4    84              END   612   1    7:3    84            ELSE IF c = BS THEN   613   1    7:5    91              BEGIN   614   1    7:6    91                IF LENGTH(STR) > 0 THEN   615   1    7:7    98                  BEGIN   616   1    7:8    98                    IF NOT BACKSPACEING THEN   617   1    7:9   102                      WRITE('<');   618   1    7:8   110                    BACKSPACEING := TRUE;   619   1    7:8   113                    IF STR[LENGTH(STR)] IN [' '..'~'] THEN   620   1    7:9   140                      WRITE(STR[LENGTH(STR)])   621   1    7:8   152                    ELSE   622   1    7:9   154                      WRITE('?');   623   1    7:8   162                    DELETE(STR,LENGTH(STR),1);   624   1    7:7   170                  END;   625   1    7:5   170              END   626   1    7:4   170            ELSE   627   1    7:5   172              BEGIN   628   1    7:6   172                IF c IN [' '..'~'] THEN   629   1    7:7   196                  WRITE(c)   630   1    7:6   204                ELSE   631   1    7:7   206                  WRITE('?');   632   1    7:6   214                If Length(str) < 80 Then   633   1    7:7   221                  Begin   634   1    7:8   221                    STR := CONCAT(STR,'#');   635   1    7:8   246                    STR[LENGTH(STR)] := c;   636   1    7:7   252                  End;   637   1    7:5   252              END;   638   1    7:2   252          END;   639   1    7:1   254        IF c = ESC THEN   640   1    7:2   259          GETSTR := FALSE;   641   1    7:1   262        WRITELN;   642   1    7:1   268        DESPACE(STR,STR);   643   1    7:1   272        IF LENGTH(STR) = 0 THEN   644   1    7:2   279          GETSTR := FALSE;   645   1    7:0   282      END;   646   1    7:0   300         647   1    3:D     3      FUNCTION TREESEARCH{KEY:STRING):BOOLEAN};   648   1    3:D    45      {   649   1    3:D    45      * This procedure finds the node with NAME=KEY in the tree with root ROOT   650   1    3:D    45      * and sets TREEPTR pointing to that node and TRAIL pointing to that node's   651   1    3:D    45      * parent.  Note that all nodes must have their links initialized to the   652   1    3:D    45      * sentinel GROUND and that ROOT is actually a dummy entry which is smaller   653   1    3:D    45      * than all entries.  This allows TRAIL to be set even in an empty tree   654   1    3:D    45      }   655   1    3:D    45      VAR   656   1    3:D    45        TEMP:STRING;   657   1    3:0     0      BEGIN   658   1    3:1     0        GROUND^.NAME := KEY;   659   1    3:1    12        TREEPTR := ROOT;   660   1    3:1    15        TEMP := '';   661   1    3:1    22        WHILE TEMP <> KEY DO   662   1    3:2    30          BEGIN   663   1    3:3    30            TRAIL := TREEPTR;   664   1    3:3    33            IF TEMP>KEY THEN   665   1    3:4    41              TREEPTR := TREEPTR^.LEFT   666   1    3:3    42            ELSE   667   1    3:4    47              TREEPTR := TREEPTR^.RIGHT;   668   1    3:3    51            DESPACE(TEMP,TREEPTR^.NAME);   669   1    3:2    58          END;   670   1    3:1    60        TREESEARCH := TREEPTR <> GROUND;   671   1    3:0    65      END;   672   1    3:0    80         673   1    4:D     1      PROCEDURE DESPACE{VAR TEMP:STRING;VAR STR:STRING};   674   1    4:D     3      {TEMP gets the string STR with all spaces removed.  Most of that   675   1    4:D     3      annoying initialization delay is spent in DESPACE, therefore I   676   1    4:D     3      have somewhat speed optimized it.}   677   1    4:D     3      VAR   678   1    4:D     3        INDEX:INTEGER;   679   1    4:0     0      BEGIN   680   1    4:1     0        TEMP := STR;   681   1    4:1     4 {$R-}   682   1    4:1     4        INDEX := SCAN(ORD(TEMP[0]),=' ',TEMP[1]);   683   1    4:1    16        WHILE INDEX <> ORD(TEMP[0]) DO   684   1    4:2    23          BEGIN   685   1    4:3    23            MOVELEFT(TEMP[INDEX+2],TEMP[INDEX+1],ORD(TEMP[0])-INDEX);   686   1    4:3    38            TEMP[0] := PRED(TEMP[0]);   687   1    4:3    46            INDEX := SCAN(ORD(TEMP[0])-INDEX+1,=' ',TEMP[INDEX]) + INDEX - 1;   688   1    4:2    66          END;   689   1    4:2    68 {$R+}   690   1    4:0    68      END;   691   1    4:0    82    692   1    8:D     1      PROCEDURE QUIT;   693   1    8:D     1      VAR   694   1    8:D     1        INDEX: INDEXRANGE;   695   1    8:D     2        OUTFILE:FILE OF MISCINFOREC;   696   1    8:0     0      BEGIN   697   1    8:1     0        REPEAT   698   1    8:1     9               {  0        1         2         3         4  }   699   1    8:1     9               {  1234567890123456789012345678901234567890  }   700   1    8:2     9          WRITELN('QUIT: D(ISK) OR M(EMORY) UPDATE,');   701   1    8:2    57          WRITELN('          R(ETURN) H(ELP) E(XIT)');   702   1    8:2   105          CASE GETCH OF   703   1    8:2   111            'D': BEGIN   704   1    8:4   111                   REWRITE(OUTFILE,NEWINFO);   705   1    8:4   134                   OUTFILE^ := BUFFER;   706   1    8:4   139                   PUT(OUTFILE);   707   1    8:4   144                   CLOSE(OUTFILE,LOCK);   708   1    8:3   150                 END;   709   1    8:2   152            'M': FOR INDEX := STARTINDEX TO ENDINDEX DO   710   1    8:4   172                   PSYSCOM^[INDEX] := BUFFER[INDEX];   711   1    8:2   200            'H':BEGIN   712   1    8:2   200                        {  0        1         2         3         4  }   713   1    8:2   200                        {  1234567890123456789012345678901234567890  }   714   1    8:4   200                  WRITELN('D(ISK) UPDATE PUTS THE CURRENT SETUP ON');   715   1    8:4   255                  WRITELN('     DISK AS THE FILE "NEW.MISCINFO"');   716   1    8:4   307                  WRITELN('     WHICH MUST BE CHANGED IN THE');   717   1    8:4   356                  WRITELN('     FILER TO "SYSTEM.MISCINFO"');   718   1    8:4   403                  WRITELN('M(EMORY) UPDATE CHANGES THE SETUP IN');   719   1    8:4   455                  WRITELN('     MEMORY UNTIL THE NEXT SYSTEM');   720   1    8:4   504                  WRITELN('     INITIALIZATION');   721   1    8:4   539                  WRITELN('R(ETURN) TAKES YOU BACK INTO SETUP');   722   1    8:4   589                  WRITELN('     IF YOU''RE NOT DONE');   723   1    8:4   628                  WRITELN('E(XIT) TERMINATES THIS PROGRAM');   724   1    8:3   674                END;   725   1    8:2   676            'E':    726   1    8:2   676               727   1    8:3   676      { --> } EXIT ( SETUP ) ;   728   1    8:3   682                 729   1    8:2   682          END;   730   1    8:1   710        UNTIL (c = 'R') OR ABORT;   731   1    8:0   717      END;   732   1    8:0   744         733   1    6:D     3      FUNCTION CONTINUE{:BOOLEAN};   734   1    6:0     0      BEGIN   735   1    6:1     0        REPEAT   736   1    6:1     0                {  0        1         2         3         4  }   737   1    6:1     0                {  1234567890123456789012345678901234567890  }   738   1    6:2     0          WRITELN('              C(ONTINUE)  Q(UIT)');   739   1    6:1    48        UNTIL GETCH IN ['C','Q'];   740   1    6:1    70        CONTINUE := c = 'C';   741   1    6:0    75      END;   742   1    6:0    90         743   1    9:D     1      PROCEDURE SHOWFULL(ORDCHAR:INTEGER;ISCHAR:BOOLEAN);   744   1    9:D     3      {Prints out the value of the field whose value is ORDCHAR and   745   1    9:D     3      which is either a character or a number, in a variety of   746   1    9:D     3      formats, such as OCTAL, DECIMAL and HEXADECIMAL, etc.}   747   1    9:D     3      TYPE   748   1    9:D     3        MANYRADIX = RECORD   749   1    9:D     3                      CASE RADIX:INTEGER OF   750   1    9:D     3                        8:(OCT:PACKED ARRAY[0..4] OF 0..7);   751   1    9:D     3                       10:(INT:INTEGER);   752   1    9:D     3                       16:(HEX:PACKED ARRAY[0..3] OF 0..15)   753   1    9:D     3                   END;{CASERECORD}   754   1    9:D     3      VAR   755   1    9:D     3        c:CHAR;   756   1    9:D     4        I:INTEGER;   757   1    9:D     5        TRIX:MANYRADIX;   758   1    9:0     0      BEGIN   759   1    9:1     0        WITH TRIX DO   760   1    9:2     0          BEGIN   761   1    9:3     0            INT := ORDCHAR;   762   1    9:3     3            WRITE(' OCTAL DECIMAL HEXADECIMAL');   763   1    9:3    39            IF ISCHAR THEN   764   1    9:4    42              BEGIN   765   1    9:5    42                IF ORDCHAR < 128 THEN   766   1    9:6    49                  WRITE(' ASCII');   767   1    9:5    65                IF ORDCHAR < 32 THEN   768   1    9:6    70                  WRITE(' CONTROL');   769   1    9:4    88              END;   770   1    9:3    88            WRITELN;   771   1    9:3    94            {WRITE THE OCTAL VALUE, RIGHT JUSTIFIED}   772   1    9:3    94              I := 4;   773   1    9:3    97              IF INT<0 THEN   774   1    9:4   102                WRITE('1')   775   1    9:3   110              ELSE   776   1    9:4   112                BEGIN   777   1    9:5   112                  WRITE(' ');   778   1    9:5   120                  WHILE (OCT[I] = 0) AND (I>0) DO   779   1    9:6   138                    BEGIN   780   1    9:7   138                      I := I - 1;   781   1    9:7   143                      WRITE(' ');   782   1    9:6   151                    END;   783   1    9:4   153                END;   784   1    9:3   153              WHILE I >= 0 DO   785   1    9:4   158                BEGIN   786   1    9:5   158                  WRITE(OCT[I]);   787   1    9:5   175                  I := I - 1;   788   1    9:4   180                END;   789   1    9:3   182              WRITE(' ');   790   1    9:3   190            {WRITE THE DECIMAL VALUE RIGHT JUSTIFIED}   791   1    9:3   190              WRITE(INT:6,'  ');   792   1    9:3   210            {WRITE THE HEXADECIMAL VALUE RIGHT JUSTIFIED}   793   1    9:3   210              I := 3;   794   1    9:3   213              WHILE (HEX[I] = 0) AND (I > 0) DO   795   1    9:4   231                BEGIN   796   1    9:5   231                  I := I - 1;   797   1    9:5   236                  WRITE(' ');   798   1    9:4   244                END;   799   1    9:3   246             WHILE I >= 0 DO   800   1    9:4   251               BEGIN   801   1    9:5   251                 IF HEX[I] < 10 THEN   802   1    9:6   265                   WRITE(HEX[I])   803   1    9:5   282                 ELSE   804   1    9:6   284                   WRITE( CHR( HEX[I] - 10 + ORD('A') ) );   805   1    9:5   305                 I := I - 1;   806   1    9:4   310               END;   807   1    9:3   312             WRITE(' ':8);   808   1    9:3   320             IF ISCHAR THEN   809   1    9:4   323               BEGIN   810   1    9:5   323                IF ORDCHAR < 33 THEN   811   1    9:6   328                  WRITE(LOWASCII[ORDCHAR],' ':4+3-LENGTH(LOWASCII[ORDCHAR]))   812   1    9:5   364                ELSE IF ORDCHAR = 127 THEN   813   1    9:7   371                  WRITE('DEL',' ':4)   814   1    9:6   392                ELSE IF CHR(ORDCHAR) IN ['!'..'}'] THEN   815   1    9:8   418                  WRITE(CHR(ORDCHAR),' ':6);   816   1    9:5   434                IF ORDCHAR < 32 THEN   817   1    9:6   439                  WRITE('^',CHR( ORDCHAR + ORD('@') ));   818   1    9:4   457              END;   819   1    9:3   457            WRITELN;   820   1    9:2   463          END;   821   1    9:0   463      END;   822   1    9:0   486         823   1    1:D     3      FUNCTION GETORDSTR   824   1   10:D     3                   (VAR ORDCHAR:INTEGER;ISCHAR:BOOLEAN;LOW,HIGH:INTEGER):BOOLEAN;   825   1   10:D     7      {The user's input for a new value may be in many forms; ASCII mnemonic,   826   1   10:D     7      hex, dec or octal number, raw character from the keyboard, etc.  This   827   1   10:D     7      procedure translates it to its numerical value which it returns in ORDCHAR}   828   1   10:D     7      VAR   829   1   10:D     7        VALID,NEGATE:BOOLEAN;   830   1   10:D     9        INDEX:1..255;   831   1   10:D    10        ORDCH:0..255;   832   1   10:D    11        DIGIT:0..16;   833   1   10:D    12        RADIX:8..16;   834   1   10:D    13        OKCHS:SET OF CHAR;   835   1   10:D    29        NUMSTR:STRING;   836   1   10:0     0      BEGIN   837   1   10:1     0        VALID := TRUE;  {INITIAL ASSUMPTION}   838   1   10:1     3        WRITE('NEW VALUE: ');   839   1   10:1    24        IF NOT GETSTR(NUMSTR) THEN   840   1   10:2    33          VALID := FALSE   841   1   10:1    33        ELSE   842   1   10:2    38          IF (LENGTH(NUMSTR) = 1) AND ISCHAR AND    843   1   10:2    46                                           NOT (NUMSTR[1] IN ['0'..'9']) THEN   844   1   10:3    68            ORDCHAR := ORD(NUMSTR[1])   845   1   10:2    74          ELSE   846   1   10:3    77            BEGIN   847   1   10:4    77              IF ISCHAR AND (LENGTH(NUMSTR)<=3) THEN   848   1   10:5    87                BEGIN   849   1   10:6    87                  LOWASCIIS[33] := NUMSTR;   850   1   10:6    99                  ORDCH := 0;   851   1   10:6   107                  WHILE NUMSTR <> LOWASCIIS[ORDCH] DO   852   1   10:7   121                    ORDCH := SUCC(ORDCH);   853   1   10:6   133                  IF NUMSTR = 'DEL' THEN   854   1   10:7   145                    ORDCH := 127;   855   1   10:5   153                END;   856   1   10:4   153              IF ISCHAR AND (ORDCH <> 33) AND (LENGTH(NUMSTR) <= 3) THEN   857   1   10:5   167                ORDCHAR := ORDCH   858   1   10:4   168              ELSE   859   1   10:5   172                BEGIN   860   1   10:6   172                  IF NOT (NUMSTR[1] IN ['D','O','H']) THEN   861   1   10:7   195                    RADIX := DEFRADIX   862   1   10:6   195                  ELSE   863   1   10:7   203                    BEGIN   864   1   10:8   203                      CASE NUMSTR[1] OF   865   1   10:8   210                        'O':RADIX := 8;   866   1   10:8   218                        'D':RADIX := 10;   867   1   10:8   226                        'H':RADIX := 16   868   1   10:8   226                      END;{CASE}   869   1   10:8   266                      DELETE(NUMSTR,1,1);   870   1   10:7   273                    END;   871   1   10:6   273                  IF NUMSTR[1] = '-' THEN   872   1   10:7   282                    BEGIN   873   1   10:8   282                      NEGATE := TRUE;   874   1   10:8   285                      DELETE(NUMSTR,1,1);   875   1   10:7   292                    END   876   1   10:6   292                  ELSE   877   1   10:7   294                    NEGATE := FALSE;   878   1   10:6   297                  CASE RADIX OF   879   1   10:6   300                    8:  OKCHS := ['0'..'7'];   880   1   10:6   319                    10: OKCHS := ['0'..'9'];   881   1   10:6   339                    16: OKCHS := ['0'..'9','A'..'F']   882   1   10:6   341                  END;{CASE}   883   1   10:6   386                  IF LENGTH(NUMSTR) = 0 THEN   884   1   10:7   394                    VALID := FALSE   885   1   10:6   394                  ELSE   886   1   10:7   399                    FOR INDEX := 1 TO LENGTH(NUMSTR) DO   887   1   10:8   424                      IF NOT (NUMSTR[INDEX] IN OKCHS) THEN   888   1   10:9   438                        VALID := FALSE;   889   1   10:6   448                  IF VALID THEN   890   1   10:7   451                    BEGIN   891   1   10:8   451                      ORDCHAR := 0;   892   1   10:8   454                      INDEX := 1;   893   1   10:8   462                      IF NUMSTR[INDEX] IN ['0'..'9'] THEN   894   1   10:9   482                        DIGIT := ORD(NUMSTR[INDEX]) - ORD('0')   895   1   10:8   488                      ELSE   896   1   10:9   496                        DIGIT := ORD(NUMSTR[INDEX]) - ORD('A') + 10;   897   1   10:8   510                      REPEAT   898   1   10:9   510                        ORDCHAR := ORDCHAR * RADIX + DIGIT;   899   1   10:9   518                        INDEX := INDEX + 1;   900   1   10:9   528                        IF INDEX <= LENGTH(NUMSTR) THEN   901   1   10:0   536                          IF NUMSTR[INDEX] IN ['0'..'9'] THEN   902   1   10:1   556                            DIGIT := ORD(NUMSTR[INDEX]) - ORD('0')   903   1   10:0   562                          ELSE   904   1   10:1   570                            DIGIT := ORD(NUMSTR[INDEX]) - ORD('A') + 10;   905   1   10:8   584                      UNTIL (INDEX > LENGTH(NUMSTR))   906   1   10:8   590                                       OR (ORDCHAR > (MAXINT - DIGIT) DIV RADIX);   907   1   10:8   603                      VALID := INDEX > LENGTH(NUMSTR);   908   1   10:8   611                      IF NEGATE THEN   909   1   10:9   614                        ORDCHAR := - ORDCHAR;   910   1   10:7   619                    END;   911   1   10:5   619                END;   912   1   10:3   619            END;   913   1   10:1   619        GETORDSTR := VALID AND (ORDCHAR >= LOW) AND (ORDCHAR<=HIGH);   914   1   10:0   632      END; {GETORDSTR}   915   1   10:0   658             916   1   11:D     1      PROCEDURE NUMTEACH(ISCHAR:BOOLEAN;LOW,HIGH:INTEGER);   917   1   11:D     4      VAR   918   1   11:D     4        c: CHAR;   919   1   11:0     0      BEGIN   920   1   11:0     0              {  0        1         2         3         4  }   921   1   11:0     0              {  1234567890123456789012345678901234567890  }   922   1   11:1     0        WRITELN('INPUT VALUES IN THE DECIMAL RANGE:');   923   1   11:1    50        WRITELN(LOW,'..',HIGH,' IN THE FORMAT BELOW:');   924   1   11:1   115        WRITELN('!->O-{OCTAL}-!');   925   1   11:1   145        WRITELN('!            !');   926   1   11:1   175        WRITELN('--DEFAULT----!----------->DIGIT--->(CR)');   927   1   11:1   230        WRITELN('!            ! !      ! !        !');   928   1   11:1   280        WRITELN('!->H-{HEX}---! !->(-)-! !-DIGIT<-!');   929   1   11:1   330        WRITELN('!            !');   930   1   11:1   360        WRITELN('!->D{DECIMAL}!');   931   1   11:1   390        IF ISCHAR THEN   932   1   11:2   393          BEGIN   933   1   11:2   393                  {  0        1         2         3         4  }   934   1   11:2   393                  {  1234567890123456789012345678901234567890  }   935   1   11:3   393            WRITELN('OR IF YOUR KEYBOARD CAN GENERATE');   936   1   11:3   441            WRITELN('THE VALUE YOU WANT, JUST TYPE THE KEY');   937   1   11:3   494            WRITELN('AND THEN TYPE CARRIAGE RETURN, OR TYPE');   938   1   11:3   548            WRITELN('THE ASCII MNEMONIC FOR THE CHARACTER');   939   1   11:2   600          END;   940   1   11:1   600        WRITELN('C(ONTINUE)');   941   1   11:1   626        REPEAT   942   1   11:1   626        UNTIL GETCH = 'C';   943   1   11:0   634      END;   944   1   11:0   650         945   1   12:D     1      PROCEDURE CHANGE;   946   1   12:D     1         947   1   13:D     3           FUNCTION DOYOU:BOOLEAN;   948   1   13:0     0           BEGIN   949   1   13:1     0             IF NOT ABORT THEN   950   1   13:2     4               REPEAT   951   1   13:3     4                 WRITELN('WANT TO CHANGE THIS VALUE?',   952   1   13:3    40                         ' (Y,N,',ESC,')');   953   1   13:3    78                 DOYOU := GETCH = 'Y';   954   1   13:2    86               UNTIL (c IN ['Y','N']) OR ABORT   955   1   13:1   104             ELSE   956   1   13:2   110               DOYOU := FALSE;   957   1   13:0   113           END;   958   1   13:0   128         959   1   14:D     1           PROCEDURE NEWRADIX;   960   1   14:D     1              961   1   15:D     1                PROCEDURE SHOWRADIX;   962   1   15:0     0                BEGIN   963   1   15:1     0                  CASE DEFRADIX OF   964   1   15:1     3                     8: WRITE('NOW OCTAL');   965   1   15:1    24                    10: WRITE('NOW DECIMAL');   966   1   15:1    47                    16: WRITE('NOW HEXADECIMAL')   967   1   15:1    72                  END;   968   1   15:0   100                END;   969   1   15:0   112              970   1   14:0     0           BEGIN {NEWRADIX}   971   1   14:1     0             REPEAT   972   1   14:2     0               SHOWRADIX;   973   1   14:2     2               WRITELN(':  O(CT) D(EC) H(EX) Q(UIT)');   974   1   14:2    45               CASE GETCH OF   975   1   14:2    51                 'O':  DEFRADIX := 8;   976   1   14:2    59                 'D':  DEFRADIX := 10;   977   1   14:2    67                 'H':  DEFRADIX := 16;   978   1   14:2    75               END;   979   1   14:1   106             UNTIL (c IN ['O','D','H','Q']) OR ABORT;   980   1   14:1   128             SHOWRADIX;   981   1   14:1   130             WRITELN;   982   1   14:0   136           END;   983   1   14:0   150         984   1   16:D     1           PROCEDURE DOIT(PTR:TREE);   985 