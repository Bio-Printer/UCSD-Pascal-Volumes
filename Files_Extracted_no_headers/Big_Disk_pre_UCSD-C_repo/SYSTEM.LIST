 154                   END  1725   0    5:7   154               END;  1726   0    5:5   154           LUNIT := VOLSEARCH(LVID,TRUE,LDIR);  1727   0    5:5   165           IF LUNIT = 0 THEN SYSCOM^.IORSLT := INOUNIT  1728   0    5:5   173           ELSE  1729   0    5:6   177             WITH UNITABLE[LUNIT] DO  1730   0    5:7   185               BEGIN (*OK...OPEN UP FILE*)  1731   0    5:8   185                 FISOPEN := TRUE; FMODIFIED := FALSE;  1732   0    5:8   197                 FUNIT := LUNIT; FVID := LVID;  1733   0    5:8   211                 FNXTBLK := 0; FISBLKD := UISBLKD;  1734   0    5:8   225                 FSOFTBUF := UISBLKD AND (FRECSIZE <> 0);  1735   0    5:8   239                 IF (LDIR <> NIL) AND (LENGTH(LTID) > 0) THEN  1736   0    5:9   251                   BEGIN (*LOOKUP OR ENTER FHEADER IN DIRECTORY*)  1737   0    5:0   251                     LINX := DIRSEARCH(LTID,FOPENOLD,LDIR);  1738   0    5:0   261                     IF FOPENOLD THEN  1739   0    5:1   264                       IF LINX = 0 THEN  1740   0    5:2   269                         BEGIN SYSCOM^.IORSLT := INOFILE; GOTO 1 END  1741   0    5:1   276                       ELSE FHEADER := LDIR^[LINX]  1742   0    5:0   286                     ELSE (*OPEN NEW FILE*)  1743   0    5:1   290                       IF LINX > 0 THEN  1744   0    5:2   295                         BEGIN SYSCOM^.IORSLT := IDUPFILE; GOTO 1 END  1745   0    5:1   302                       ELSE  1746   0    5:2   304                         BEGIN (*MAKE A TEMP ENTRY*)  1747   0    5:3   304                           IF LKIND = UNTYPEDFILE THEN LKIND := DATAFILE;  1748   0    5:3   312                           LINX := ENTERTEMP(LTID,LSEGS,LKIND,LDIR);  1749   0    5:3   323                           IF (LINX > 0) AND (LKIND = TEXTFILE) THEN  1750   0    5:4   332                             WITH LDIR^[LINX] DO  1751   0    5:5   338                               BEGIN  175